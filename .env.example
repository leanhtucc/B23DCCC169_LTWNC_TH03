# NextAuth v5 secret (tạo bằng: openssl rand -base64 32)
AUTH_SECRET="your-32-character-secret-key-goes-here"

# URL gốc của site (dùng cho sitemap, OG image, JSON-LD). Trên Vercel có thể bỏ trống.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bonus: GitHub OAuth (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email GitHub được cấp quyền admin (phân cách bằng dấu phẩy)
ADMIN_EMAILS=""
